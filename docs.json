{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "Liberal Wiki",
  "colors": {
"primary": "#202122",
"light": "#F8F9FA",
"dark": "#000000"
  },
"fonts": {
  "heading": {
    "family": "Inter",
    "weight": 700
  },
  "body": {
    "family": "JetBrains Mono",
    "weight": 400
  }
},
  "favicon": "/favicon.svg",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Centre for Civil Society",
          "icon": "book-open-cover",
          "href": "https://ccs.in/"
        },
        {
          "anchor": "CCS Blogs",
          "icon": "newspaper",
          "href": "https://ccs.in/all-publications"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Home",
        "pages": [
          "index",
          "faq"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/ccsindia",
      "linkedin": "https://www.linkedin.com/company/ccsindia/"
    }
  },
  "seo": {
    "indexing": "all"
  },
  "interaction": {
    "drilldown": true
  },
  "appearance": {
    "default": "light"
  }
  
}
